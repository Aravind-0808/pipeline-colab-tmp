# DataForge pipeline. Copy to .env.production on the pipeline server (deploy.sh
# reads it), or to .env.development for local development (read by default).
# No database settings: this project has no database, on purpose.

# --- The app server ---------------------------------------------------------------------
# The app server's Redis, over the private network, with the app server's REDIS_PASSWORD.
REDIS_URL=redis://:change-me-to-a-long-random-string@10.0.0.1:6379/0

# --- Storage: the app server's MinIO -----------------------------------------------
# Over the private network (Tailscale), with the pipeline's own access key
# (made on the app server: PIPELINE_S3_ACCESS_KEY / PIPELINE_S3_SECRET_KEY).
S3_ENDPOINT=http://10.0.0.1:19000
S3_ACCESS_KEY=pipeline
S3_SECRET_KEY=change-me-to-a-long-random-string
S3_BUCKET=dataforge

# --- Hugging Face: only to publish a finished dataset --------------------------------
HF_TOKEN=hf_your_write_token

# --- The model (the AI check) -------------------------------------------------------
# The LiteLLM gateway; on this machine, its local address.
LLM_API_BASE=http://host.docker.internal:4000/v1
LLM_API_KEY=EMPTY
LLM_MODEL=hosted_vllm/nvidia/Qwen3.6-35B-A3B-NVFP4
LLM_TIMEOUT_SEC=90
LLM_MAX_CONCURRENCY=2

# The AI check watches each clip as a small MJPEG video, made on this machine
# and thrown away after (the model server cannot read phone H.264). If the
# model will not take it, the grid of frames is used. false = grid only.
CHECK_WITH_VIDEO=true
CHECK_VIDEO_WIDTH=448
CHECK_VIDEO_FPS=4
CHECK_VIDEO_MAX_FRAMES=120

# --- When it works ------------------------------------------------------------------
# The DGX is the pipeline's only at night: workers run inside these hours and
# are stopped outside them; work waits in the queue meanwhile, and work still
# running at the end is handed back and finished the next night. Empty = always.
PIPELINE_HOURS=22:00-09:00
# IST, India Standard Time (UTC+5:30). "IST" is accepted as a short name too.
PIPELINE_TZ=Asia/Kolkata
# At the end of the hours, running work has this long to finish.
STOP_GRACE_SEC=600

# --- The GPU ------------------------------------------------------------------------
# off (the default): always the CPU — on the DGX the GPU belongs to the models
# and training. auto: hand tracking and dataset video encoding use the NVIDIA
# GPU where it works (deploy.sh then gives the container the GPU). on: try the
# GPU even without an NVIDIA driver, and warn on falling back.
PIPELINE_GPU=off
# The share of the GPU's memory hand tracking's models may hold (one process).
GPU_MEMORY_FRACTION=0.25

# --- How the hand is seen (docs/HAND2ROBOT_2.md) -------------------------------------
# Off by default: MediaPipe and guessed distances, all on the CPU, as before.
# Turning a model on needs it in the image (PERCEPTION, below), PIPELINE_GPU=auto,
# and scripts/gpu_smoke.py passing on this machine first. With a model on, hand
# tracking runs one clip at a time.
# RETARGET_DEPTH_MODEL=moge-2-vitb     # off | moge-2-vits | moge-2-vitb | moge-2-vitl
# RETARGET_HAND_MODEL=wilor            # mediapipe | wilor (experimental)
# RETARGET_DEPTH_FRAMES=12             # frames per clip the depth model looks at
# PERCEPTION_WORKER_MEMORY_MB=8000     # a track process holding the models is replaced past this
# Build-time (docker-compose.yaml passes them to the Dockerfile):
# PERCEPTION=depth                     # depth | "depth wilor": the models put in the image
# TORCH_INDEX=https://download.pytorch.org/whl/cu130   # PyTorch's CUDA build, for the GPU

# --- How much at once (never everything at the same time) --------------------------
CHECK_CONCURRENCY=2      # AI checks: frames + one model call each
TRACK_CONCURRENCY=2      # MediaPipe hand tracking: about a core each
BUILD_CONCURRENCY=1      # dataset builds and publishing

# --- Its share of the machine (the DGX also runs the models and training) ----------
PIPELINE_MEM_LIMIT=16g   # the container is stopped past this, never the models
PIPELINE_CPUS=8          # cores the container may use in all
CPU_THREADS=2            # per process: numpy/BLAS, OpenMP, OpenCV
WORKER_MAX_TASKS=50      # a worker process is replaced after this many tasks...
WORKER_MAX_MEMORY_MB=3000  # ...or once it holds this much memory
# The name this machine shows on the app server's Monitor page.
NODE_NAME=pipeline

# --- Retargeting gates (optional; these are the defaults) -------------------------
# Whether hand coordinates and arm trajectories are fit to train on. Decided
# here; the app server records the verdict.
# RETARGET_MIN_HAND_COVERAGE=0.70
# RETARGET_MIN_OBJECT_FRAMES=0.50
# RETARGET_MIN_REACHABLE=0.85
# RETARGET_MAX_SLOWDOWN=3.0
# Must match the app server's, or results are stamped with a version the app server does not ask for.
RETARGET_PIPELINE_VERSION=hand2robot-1.0
